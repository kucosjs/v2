# Defaults for a local server.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000

# Database managed by Prisma.
DATABASE_URL=file:./data/kucos.sqlite
# DATABASE_URL="postgres://username:password@127.0.0.1:5432/kucos_database"

# Comma-separated origins of sites allowed to host the embed.
ALLOWED_ORIGINS=

# Set a strong password to enable /admin.
ADMIN_PASSWORD=

# Optional Akismet moderation. Set a key to enable.
AKISMET_API_KEY=
AKISMET_TESTING=false

# Number of trusted reverse proxies in front of Node.
TRUST_PROXY_HOPS=0
