generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
  // provider = "postgresql"
}

enum Moderation {
  published
  pending
  spam
}

model Article {
  id       String    @id @default(uuid())
  url      String    @unique
  comments Comment[]
  kudos    Kudos?
}

model Comment {
  id         String     @id @default(uuid())
  articleId  String
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author     String     @default("Anonymous")
  content    String
  email      String?
  website    String?
  owner      String
  parentId   String?
  parent     Comment?   @relation("Replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[]  @relation("Replies")
  moderation Moderation @default(published)
  pinned     Boolean    @default(false)
  likes      Int        @default(0)
  dislikes   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
  ip         String?
  userAgent  String?
  votes      Vote[]

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([moderation, createdAt])
}

model Vote {
  commentId String
  visitor   String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, visitor])
}

model Kudos {
  articleId String        @id
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  count     Int           @default(0)
  members   KudosMember[]
}

model KudosMember {
  articleId String
  visitor   String
  kudos     Kudos  @relation(fields: [articleId], references: [articleId], onDelete: Cascade)

  @@id([articleId, visitor])
}
