{
  "name": "kucos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Embeddable comments and kudos for static websites",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "start": "node dist/server.js",
    "dev": "node --watch --import tsx src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:import": "node --import tsx scripts/import-legacy.ts",
    "build": "npm run build:widget && prisma generate && tsc",
    "build:widget": "esbuild public/embed/kucos.js public/embed/kucos.css --minify --target=es2020 --outdir=dist/widget --out-extension:.js=.min.js --out-extension:.css=.min.css",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "akismet-api": "^6.0.0",
    "dotenv": "^18.0.10",
    "he": "^2.0.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@hono/cli": "^1.0.0-rc.9",
    "@types/he": "^1.2.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
