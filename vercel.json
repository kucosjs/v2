{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "outputDirectory": "dist/vercel",
  "buildCommand": "npm run build && mkdir -p dist/vercel public/min && cp scripts/vercel.mjs dist/vercel/index.mjs && cp dist/widget/kucos.min.js dist/widget/kucos.min.css public/min/",
  "headers": [
    {
      "source": "/min/:path*",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
